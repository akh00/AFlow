{
  "name": "@aflow/engine",
  "version": "0.1.0",
  "private": true,
  "description": "AFlow workflow evaluation engine (spec artifact 4)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run build -w @aflow/dsl && node packages/dsl/dist/cli.mjs types --project packages/dsl/test/fixtures/booking/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/dsl/test/fixtures/booking/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ]
}
