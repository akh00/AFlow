{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "BookingRequest": {
      "type": "object",
      "required": ["order_id", "customer", "payment_instrument", "order_lines"],
      "properties": {
        "order_id": { "type": "string" },
        "currency": { "type": "string" },
        "customer": { "$ref": "#/definitions/Customer" },
        "payment_instrument": { "$ref": "#/definitions/PaymentInstrument" },
        "order_lines": { "type": "array", "items": { "$ref": "#/definitions/OrderLine" } }
      }
    },
    "Customer": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "OrderLine": {
      "type": "object",
      "required": ["id", "product_type", "supplier", "amount"],
      "properties": {
        "id": { "type": "string" },
        "product_type": { "enum": ["hotel", "flight"] },
        "supplier": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" }
      }
    },
    "PaymentInstrument": {
      "type": "object",
      "required": ["type", "token"],
      "properties": {
        "type": { "enum": ["card", "invoice"] },
        "token": { "type": "string" },
        "holder": { "type": "string" },
        "expiry": { "type": "string" },
        "billing_country": { "type": "string" }
      }
    },
    "BookingResponse": {
      "type": "object",
      "required": ["order_id", "status", "bookings"],
      "properties": {
        "order_id": { "type": "string" },
        "status": { "enum": ["BOOKED"] },
        "currency": { "type": "string" },
        "total": { "type": "number" },
        "payment": { "type": "object" },
        "bookings": { "type": "array", "items": { "type": "object" } },
        "audit": { "type": "object" }
      }
    }
  }
}
